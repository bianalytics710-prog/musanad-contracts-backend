# =============================================================================
# Musanad Contracts Hub — Backend Environment Template
# Copy to .env.local for local dev; .env for production deployment.
# Never commit a populated .env file.
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/musanad_contracts
DATABASE_POOL_MAX=20

# Test branch — isolated DB used by `npm test` (tests/helpers/setup.ts swaps it in)
# and `npm run migrate:test` (applies migrations to this branch).
# Leave empty to fall back to DATABASE_URL.
TEST_DATABASE_URL=

# --- Auth (JWT) ---
JWT_SECRET=replace_with_long_random_string_min_32_chars
JWT_AUDIENCE=musanad-contracts
JWT_ISSUER=musanad-contracts-backend
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- AI Provider (replaces Lovable AI Gateway) ---
# AI_PROVIDER selects which client implementation to use.
# Add ANTHROPIC_API_KEY when migrating to Claude.
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL_DEFAULT=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# --- Email (Nodemailer + SMTP) ---
# Dev: Mailpit (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit) → http://localhost:8025
# Prod: any SMTP provider (Brevo, Mailtrap, Resend, SES, self-hosted Postfix)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Musanad Contracts
SMTP_FROM_EMAIL=no-reply@musanad.local

# --- UAE Pass (mocked for dev) ---
# TODO[uae-pass-integration]: Replace with real UAE Pass federation before go-live.
# See docs/uae-pass-integration.md for the integration checklist.
UAE_PASS_PROVIDER=mock
UAE_PASS_CLIENT_ID=
UAE_PASS_CLIENT_SECRET=
UAE_PASS_AUTHORIZE_URL=
UAE_PASS_TOKEN_URL=
UAE_PASS_USERINFO_URL=
UAE_PASS_REDIRECT_URI=http://localhost:4000/auth/uae-pass/callback

# --- Storage (Supabase for now) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=contracts

# --- Observability (deferred) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=musanad-contracts-backend

# --- Frontend integration ---
CORS_ORIGIN=http://localhost:5173

# --- Request correlation ---
REQUEST_ID_HEADER=X-Request-ID

# --- M1b: Contract Exports (PDF + XLSX) ---
# Optional override for the Puppeteer-bundled Chromium binary. Useful in
# Alpine / restricted-network environments. Leave empty to use the binary
# Puppeteer downloads on `npm install`.
PUPPETEER_EXECUTABLE_PATH=
# Per-user budget for the heavy export endpoints (PDF + XLSX). Defaults to 30
# requests per minute when unset (api-contracts.json N4 / AC-S4-09 / AC-S5-10).
EXPORT_RATE_LIMIT_PER_MIN=30
# Codex BE-M1b-003: hard cap on concurrent Puppeteer page renders. The
# backend reuses ONE Chromium process across requests; this gates how many
# pages can render in parallel. Defaults to 2 — raise carefully on hosts
# with more memory budget. Hard upper bound is 16.
PUPPETEER_MAX_CONCURRENT=2

# --- M2: Approval Workflows ---
# Cron expression controlling how often the approval-escalation sweep runs
# (S9 — fn_approval_escalate). Default '*/15 * * * *' (every 15 minutes).
# Disabled entirely in NODE_ENV=test. Validate with:
#   https://crontab.guru/ or `node -e "require('node-cron').validate('...')"`
APPROVAL_ESCALATION_INTERVAL_CRON=*/15 * * * *

# --- M_parity: Supabase storage for contract attachments ---
# Project URL and SERVICE-ROLE secret key for the dedicated Musanad storage
# project (musanad-contracts-storage, project ref zicbnpkewdctnjcstynt).
# The service-role key bypasses RLS and is BE-ONLY — never ship to FE,
# never log, never commit.
SUPABASE_URL=https://zicbnpkewdctnjcstynt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<paste-service-role-secret-from-supabase-dashboard>

# ---- CR-MIG-DRIVE / M22 ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google-drive/callback
# 32-byte base64-encoded AES-256-GCM key (dev). Production must rotate to KMS.
TOKEN_CIPHER_KEY=
OAUTH_STATE_HMAC_SECRET=
MIGRATION_SYNC_WORKER_ENABLED=false
