{
  "name": "musanad-contracts-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Musanad Contracts Hub backend API — Express + TypeScript + PostgreSQL (Neon).",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch -r dotenv/config src/server.ts dotenv_config_path=.env.local",
    "build": "node --max-old-space-size=512 ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "build:fallback": "node --max-old-space-size=1024 ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node --max-old-space-size=512 ./node_modules/typescript/bin/tsc --noEmit",
    "typecheck:fallback": "node --max-old-space-size=1024 ./node_modules/typescript/bin/tsc --noEmit",
    "start": "node -r dotenv/config dist/server.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest",
    "test:coverage": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --coverage",
    "migrate": "tsx -r dotenv/config src/database/migrate.ts up dotenv_config_path=.env.local",
    "migrate:down": "tsx -r dotenv/config src/database/migrate.ts down dotenv_config_path=.env.local",
    "migrate:test": "tsx -r dotenv/config src/database/migrate.ts up --target=test dotenv_config_path=.env.local",
    "migrate:test:down": "tsx -r dotenv/config src/database/migrate.ts down --target=test dotenv_config_path=.env.local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.50.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/instrumentation-express": "^0.42.0",
    "@opentelemetry/instrumentation-http": "^0.53.0",
    "@opentelemetry/instrumentation-pg": "^0.46.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@supabase/supabase-js": "^2.105.3",
    "@types/multer": "^2.1.0",
    "@types/mustache": "^4.2.6",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "fast-xml-parser": "^4.5.0",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "mustache": "^4.2.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "openai": "^4.73.0",
    "p-limit": "^3.1.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "puppeteer": "^24.42.0",
    "rate-limiter-flexible": "^5.0.4",
    "rss-parser": "^3.13.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.16",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitest/coverage-v8": "^2.1.5",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
